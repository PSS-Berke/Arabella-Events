# Contact form email delivery (app/api/contact/route.js).
# The form calls the Resend REST API directly (https://api.resend.com/emails);
# no npm package is required. Until all three vars are set, the API returns 503
# and the contact form shows a graceful "not set up yet" message.
# Copy this file to .env.local and fill in the values.

# API key from https://resend.com -> API Keys
RESEND_API_KEY=

# Inbox that receives contact-form submissions
CONTACT_TO_EMAIL=arabella@arabellasweddings.com

# Verified sender on the Resend account's domain,
# e.g. "Arabella's Weddings & Events <inquiries@arabellasweddings.com>"
CONTACT_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Measurement (Phase 1). Every one of these is optional: the site renders and
# behaves identically when they are unset, and no third-party script loads.
# ---------------------------------------------------------------------------

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Leave blank to ship with no analytics and no cookies.
NEXT_PUBLIC_GA_ID=

# Search Console ownership proof: Search Console -> Add property ->
# HTML tag method -> copy only the content="..." value (not the whole tag).
# The DNS TXT method is stronger if you control the domain's DNS; if you use
# that instead, leave this blank.
GOOGLE_SITE_VERIFICATION=

# Bing Webmaster Tools ownership proof (msvalidate.01 content value).
# Bing can import the property straight from Search Console, which is easier.
BING_SITE_VERIFICATION=
